{
  "name": "warsim",
  "private": true,
  "version": "0.1.0",
  "description": "warsim \u2014 stance-based black-powder battle simulation prototype",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "headless": "pnpm --filter @warsim/headless run start --",
    "web": "pnpm --filter @warsim/web run dev",
    "web:build": "pnpm --filter @warsim/web run build",
    "web:artifact": "pnpm --filter @warsim/web run build:artifact"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
